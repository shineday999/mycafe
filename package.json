{
  "name": "mycafe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "森林系手作品牌電商——琥珀飾品與香品,大東南亞+中東市場,六語在地化",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "wrangler pages deploy ./dist --project-name=mycafe --branch=main --commit-dirty=true",
    "check": "astro check",
    "test": "vitest run",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "format": "prettier --write \"**/*.{ts,tsx,astro,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,astro,json,md,yml}\"",
    "prepare": "husky",
    "postbuild": "node scripts/postbuild-fix-assets-binding.cjs && node scripts/postbuild-copy-client.cjs",
    "preinstall": "npx only-allow pnpm",
    "check:i18n": "node scripts/check-i18n-keys.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.13",
    "@astrojs/react": "^7.1.9",
    "astro": "^7.4.12",
    "autoprefixer": "^10.4.0",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.10",
    "jose": "^6.2.12",
    "postcss": "^8.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "style-dictionary": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.8",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/ui": "^2.1.9",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "nodemailer": "^10.0.13",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^0.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.169.0"
  },
  "lint-staged": {
    "*.{ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.14.0"
}
