            <RevealOnScroll class="h-full">
              <ProductCard
                slug={featured.results[0].slug}
                name={featured.results[0].name ?? featured.results[0].slug}
                shortDescription={
                  featured.results[0].short_description ?? undefined
                }
                category={featured.results[0].category}
                imageUrl={firstImage(featured.results[0].image_urls)}
                priceFrom={
                  featured.results[0].min_price
                    ? formatPrice(
                        featured.results[0].min_price ?? 0,
                        featured.results[0].min_currency ?? "TWD",
